{
  "name": "deeksha-gowda-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Premium React and Vite portfolio for Deeksha Gowda",
  "scripts": {
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "predev": "npm run stop",
    "dev:fresh": "npm run stop && npm run dev",
    "dev": "concurrently \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
